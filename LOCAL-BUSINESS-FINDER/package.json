{
  "name": "local-business-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Recherche locale d’entreprises avec OpenStreetMap, sans compte ni API payante",
  "scripts": {
    "start": "python3 server.py --no-browser",
    "test": "node --test tests/*.test.js",
    "check": "find js -name '*.js' -exec node --check {} \\;",
    "test:browser": "node tests/browser.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1"
  }
}
